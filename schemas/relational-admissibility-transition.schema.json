{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admissible-existence.invalid/schemas/relational-admissibility-transition.schema.json",
  "title": "Relational Admissibility Transition Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "predecessor_state",
    "candidate",
    "governance_context",
    "resolution",
    "successor_state",
    "relations",
    "affected_components",
    "newly_implicated_components",
    "deimplicated_components",
    "observation_trigger",
    "authority_effect",
    "credential_authority",
    "github_token_runtime_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "admissible-existence.relational-admissibility-transition/v1"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_state": {
      "$ref": "#/$defs/state"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "sought_effect", "origin_component"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "sought_effect": {},
        "origin_component": {"type": "string", "minLength": 1},
        "implicated_components": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "governance_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_refs", "policy_refs", "authority_basis_refs"],
      "properties": {
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "policy_refs": {"type": "array", "items": {"type": "string"}},
        "authority_basis_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "resolution_valid",
        "requested_effect_authorized",
        "requested_effect_realized",
        "reason_codes"
      ],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "resolution_valid": {"type": "boolean"},
        "requested_effect_authorized": {"type": "boolean"},
        "requested_effect_realized": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "successor_state": {
      "$ref": "#/$defs/state"
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "affected_components": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "newly_implicated_components": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "deimplicated_components": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "observation_trigger": {
      "enum": ["STATE_TRANSITION", "EXPLICIT_CLOCK_STATE_TRANSITION"]
    },
    "authority_effect": {
      "const": "NONE"
    },
    "credential_authority": {
      "const": "TV/TVC"
    },
    "github_token_runtime_authority": {
      "const": "NONE"
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "state_hash", "component_states", "relation_states"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "state_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "component_states": {"type": "object"},
        "relation_states": {"type": "object"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "subjects",
        "predicate",
        "state",
        "predecessor_value",
        "successor_value",
        "evidence_refs"
      ],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "predicate": {"type": "string", "minLength": 1},
        "state": {
          "enum": [
            "CHANGED",
            "CONFIRMED_INVARIANT",
            "CONTRADICTED",
            "EMERGED",
            "DISAPPEARED",
            "DEPENDENCY_ESTABLISHED",
            "DEPENDENCY_REMOVED",
            "CONTINUITY_ESTABLISHED",
            "MANIFOLD_IMPLICATED",
            "MANIFOLD_DEIMPLICATED",
            "UNOBSERVED"
          ]
        },
        "predecessor_value": {},
        "successor_value": {},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
